# YARA Automation Environment Variables
# Copy this file to .env and fill in your API keys

# YARAify Auth Key (required)
# Get your free key at: https://auth.abuse.ch/
YARAIFY_AUTH_KEY=your-yaraify-auth-key-here

# MalwareBazaar API Key (optional - works without key but has lower rate limits)
# MALWAREBAZAAR_API_KEY=your-malwarebazaar-key-here

# Malpedia API Token (optional - for TLP:GREEN access to more YARA rules)
# Get free account at: https://malpedia.caad.fkie.fraunhofer.de/
# Without key: Access to TLP:WHITE rules + auto-generated rules
# With key: Additional TLP:GREEN rules (more comprehensive coverage)
# MALPEDIA_API_KEY=your-malpedia-api-token-here
